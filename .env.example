# Copy to an untracked environment file and replace every placeholder.
# Do not reuse production credentials. Password below must be URL-safe.
COMPOSE_PROJECT_NAME=nianzeuhub-f02-test
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=app_test
MINIO_ROOT_USER=REPLACE_WITH_RANDOM_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_STORAGE_SECRET
APP_QUOTA_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ENVIRONMENT=test
APP_FRONTEND_ORIGIN=http://localhost:3000
APP_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
APP_SECURE_COOKIES=false
# These ports bind only to loopback; no database or console port is published.
API_PORT=8000
STORAGE_PORT=9000
