# Copy to an untracked file, replace every placeholder, chmod 600.
# Never commit a real value. Every variable below is read from the environment
# only; no script contains a default credential.

# --- destination (must be outside the production Docker volumes) ------------
BACKUP_ROOT=/srv/backups/nianzeuhub
BACKUP_PASSPHRASE=REPLACE_WITH_RANDOM_PASSPHRASE_AT_LEAST_32_CHARACTERS

# --- production stack coordinates (names from `docker ps`) ------------------
BACKUP_API_CONTAINER=nianzeuhub-api-1
BACKUP_DOCKER_NETWORK=nianzeuhub_default
BACKUP_PGHOST=db
BACKUP_S3_HOST=minio:9000
BACKUP_S3_SCHEME=http

# --- production credentials (same values as the application environment) ---
BACKUP_PGUSER=app
BACKUP_PGDATABASE=app
BACKUP_PGPASSWORD=REPLACE_WITH_THE_PRODUCTION_POSTGRES_PASSWORD
BACKUP_S3_ACCESS_KEY=REPLACE_WITH_THE_PRODUCTION_MINIO_ACCESS_KEY
BACKUP_S3_SECRET_KEY=REPLACE_WITH_THE_PRODUCTION_MINIO_SECRET
BACKUP_QUARANTINE_BUCKET=quarantine
BACKUP_VALIDATED_BUCKET=validated

# --- behaviour --------------------------------------------------------------
# 1 stops the API container for the snapshot: atomic point, short outage.
# 0 keeps the service live: the backup point is NOT atomic (see docs/backup.md).
BACKUP_FREEZE=1
# 0 (default) captures only the validated bucket: quarantine objects live at
# most 24 h and the hourly cleanup deletes them. See docs/backup-scope.md.
BACKUP_INCLUDE_QUARANTINE=0
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_APP_VERSION=REPLACE_WITH_THE_DEPLOYED_GIT_SHA
# Pin both tool images to a digest once pulled: `docker image ls --digests`.
BACKUP_PG_IMAGE=postgres:16-alpine
BACKUP_MC_IMAGE=quay.io/minio/mc:latest

# --- throwaway restore target (ops/backup/restore-stack.yaml) --------------
RESTORE_CONFIRM_ISOLATED=yes
RESTORE_DB_CONTAINER=nianzeuhub-restore-restore-db-1
RESTORE_DOCKER_NETWORK=nianzeuhub-restore_default
RESTORE_PGHOST=restore-db
RESTORE_S3_HOST=restore-minio:9000
RESTORE_S3_SCHEME=http
RESTORE_PGUSER=restore
RESTORE_PGDATABASE=restore
RESTORE_PGPASSWORD=REPLACE_WITH_RANDOM_DISPOSABLE_PASSWORD
RESTORE_S3_ACCESS_KEY=REPLACE_WITH_RANDOM_DISPOSABLE_ACCESS_KEY
RESTORE_S3_SECRET_KEY=REPLACE_WITH_RANDOM_DISPOSABLE_SECRET
RESTORE_QUARANTINE_BUCKET=quarantine
RESTORE_VALIDATED_BUCKET=validated
